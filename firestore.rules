rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seuls nos deux comptes Google peuvent lire et modifier le budget
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['TON_EMAIL@gmail.com', 'EMAIL_DE_PRINCESSE@gmail.com'];
    }
  }
}
